<?xml version="1.0" encoding="utf-8"?>
<!-- INTERNET is only for downloading map files the person asks for, and for the optional update
     check once switched on (no location or activity data); nothing else goes out. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="id.ghostwalk.app"
    android:versionCode="9"
    android:versionName="0.5.0">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep recording with the screen off, with a notification saying so. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Step counter, and a buzz for interval changes. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Installing a checked update, only when the optional updates are switched on and confirmed. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <application
        android:label="GhostWalk"
        android:icon="@drawable/icon"
        android:hasCode="true"
        android:allowBackup="false">
        <activity
            android:name="id.ghostwalk.app.GhostActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
            <meta-data android:name="android.app.lib_name" android:value="ghostwalk" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="id.ghostwalk.app.Tracker"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
